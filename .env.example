APP_ENV=development
APP_DEBUG=false
PHP_ERROR_LOG=
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI

DB_HOST=127.0.0.1
DB_NAME=sistema_pausas
DB_USER=chronodesk_app
DB_PASS=troque_esta_senha

AUTH_SOURCE=ad
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict
FORCE_HTTPS=false
CI_SESSION_ABSOLUTE_TIMEOUT=28800
CI_SESSION_IDLE_TIMEOUT=1800

AD_DOMAIN=gruponp.local
AD_UPN_SUFFIX=paschoalotto.com.br
AD_SERVERS=servidor-ad-1.exemplo.local,servidor-ad-2.exemplo.local
AD_PORT=389
AD_USE_TLS=false
ENABLE_AD_AUTO_LINK=false
# Reservado para operacoes AD futuras que exijam conta de servico.
# O login atual continua usando bind direto com a credencial do usuario.
AD_CREDENTIAL_PROVIDER=none
AD_BIND_USER=
AD_BIND_PASS=
AD_BIND_USER_FILE=/run/chronodesk/ad-bind-user
AD_BIND_PASS_FILE=/run/chronodesk/ad-bind-pass

AD_ADMIN_USERS=usuario.admin
ENABLE_LOCAL_ADMIN=false

APP_BASE_URL=http://localhost/chronodesk_v3
METRICS_MAX_ROWS=10000
MAIL_ENABLED=false
MAIL_FROM=sdk@example.com
MAIL_FROM_NAME=ChronoDesk
MAIL_APPROVERS=aprovador1@example.com,aprovador2@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10

SENIOR_API_URL=
SAILPOINT_API_URL=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_WORKBOOK_PATH=
TEAMS_ENABLED=false
SERVICENOW_API_URL=
GRAFANA_URL=
ZABBIX_API_URL=
WAZUH_API_URL=
DOCUMENT_STORAGE_PATH=
SHIFT_STORAGE_PATH=
