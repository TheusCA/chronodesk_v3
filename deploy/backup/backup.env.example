# Configuracao do backup do ChronoDesk (scripts/backup-chronodesk.sh)
# Instalar em /etc/chronodesk/backup.env (root, modo 600).
# Formato CHAVE=valor. O arquivo e lido, nunca executado; chave desconhecida aborta.
# Nao coloque senha aqui: credenciais do MySQL ficam em MYSQL_CNF.

# Nome do container MySQL (docker ps).
MYSQL_CONTAINER=<NOME_CONTAINER_MYSQL>

DB_NAME=sistema_pausas

# Arquivo de opcoes do MySQL com [client] user= e password= (root, modo 600 ou 400).
MYSQL_CNF=/etc/chronodesk/backup-mysql.cnf

# Um diretorio por execucao, no formato AAAAMMDD-HHMMSS.
BACKUP_ROOT=/var/backups/chronodesk

# Backups com mais de N dias sao removidos apos um backup bem-sucedido.
RETENTION_DAYS=14

# Clone da aplicacao (estado.json, pausas.csv, config_sistema.json, funcionarios.json).
APP_DIR=/var/www/chronodesk

# Diretorios privados, separados por espaco. Devem cobrir DOCUMENT_STORAGE_PATH
# e SHIFT_STORAGE_PATH do .env. Diretorio inexistente aborta o backup.
PRIVATE_DIRS=/var/lib/chronodesk
