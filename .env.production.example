APP_ENV=production
APP_DEBUG=false
SECRET_KEY=troque_por_uma_chave_forte

# Com Apache/PHP na VM e MySQL Docker publicado em 127.0.0.1:3306, use 127.0.0.1.
# Se PHP tambem rodar em container no futuro, use o nome do servico/container na rede Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_pausas
DB_USER=chronodesk_app
DB_PASS=troque_essa_senha
DB_CHARSET=utf8mb4

ALLOWED_ORIGINS=https://chronodesk.interno.local
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict
# ATENCAO: este arquivo e um EXEMPLO e assume um VirtualHost HTTPS ja validado
# para o ChronoDesk. Hoje o ChronoDesk roda apenas em HTTP: o HTTPS existente na
# VM pertence a outra aplicacao. Copiar este arquivo como .env sem antes publicar
# um certificado proprio causa INDISPONIBILIDADE TOTAL, porque FORCE_HTTPS=true
# faz toda requisicao responder 301 para um https:// que nao atende.
# Mantenha FORCE_HTTPS=false e SESSION_COOKIE_SECURE=false ate o HTTPS existir.
FORCE_HTTPS=true

AUTH_SOURCE=ad
AD_DOMAIN=dominio.exemplo.local
AD_UPN_SUFFIX=exemplo.com.br
AD_SERVERS=servidor-ad-1.exemplo.local,servidor-ad-2.exemplo.local
# Esquema de conexao com o AD.
#   ldap  (padrao) = texto claro. Credencial do usuario trafega sem cifra.
#   ldaps          = TLS implicito, normalmente com AD_PORT=636.
# Alternativa a ldaps: manter AD_SCHEME=ldap com AD_PORT=389 e AD_USE_TLS=true
# (StartTLS). Nao combine ldaps com AD_USE_TLS=true: o codigo ignora o StartTLS
# e registra aviso, porque o canal ja esta cifrado.
#
# PRE-REQUISITO para ldaps ou StartTLS: a CA que assinou o certificado dos
# controladores de dominio precisa ser confiavel na VM. Sem isso o bind falha,
# por desenho: o codigo exige certificado valido (LDAP_OPT_X_TLS_REQUIRE_CERT
# = demand) sempre que houver TLS, para impedir certificado forjado no caminho.
# Instale a CA em /usr/local/share/ca-certificates/ e rode update-ca-certificates.
# Confira tambem que /etc/ldap/ldap.conf nao contenha TLS_REQCERT never/allow.
# Teste antes de ativar:
#   openssl s_client -connect <dc>:636 -showcerts </dev/null
AD_SCHEME=ldap
AD_PORT=389
AD_USE_TLS=true
ENABLE_AD_AUTO_LINK=false
# Preparacao para conta de servico futura. Nao altera o bind do login atual.
AD_CREDENTIAL_PROVIDER=none
AD_BIND_USER=
AD_BIND_PASS=
AD_BIND_USER_FILE=/run/chronodesk/ad-bind-user
AD_BIND_PASS_FILE=/run/chronodesk/ad-bind-pass
AD_ADMIN_USERS=usuario.admin
ENABLE_LOCAL_ADMIN=false

# Limite de tentativas de login por usuario, independente de IP (SEC-03).
# Toda tentativa conta; so o login concluido zera. A contagem zera depois de
# LOGIN_USER_WINDOW_SECONDS sem tentativas (mesma regra do AD). Para nunca
# levar a conta ao bloqueio do dominio: MAX abaixo do limite do AD e WINDOW
# maior ou igual a janela de observacao do AD (valores do dominio: TO CONFIRM).
# Faixas aceitas: MAX 1 a 20, WINDOW 60 a 86400. Ausente ou invalido: 5 e 900.
LOGIN_USER_MAX_FAILURES=5
LOGIN_USER_WINDOW_SECONDS=900

APP_BASE_URL=https://chronodesk.interno.local
METRICS_MAX_ROWS=10000
MAIL_ENABLED=false
MAIL_FROM=sdk@example.com
MAIL_FROM_NAME=Portal SDK
MAIL_APPROVERS=aprovador1@example.com,aprovador2@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10

SENIOR_API_URL=
SAILPOINT_API_URL=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_WORKBOOK_PATH=
TEAMS_ENABLED=false
SERVICENOW_API_URL=
GRAFANA_URL=
ZABBIX_API_URL=
WAZUH_API_URL=
DOCUMENT_STORAGE_PATH=/var/lib/chronodesk/documents
SHIFT_STORAGE_PATH=/var/lib/chronodesk/shift-schedules

# Health check (api/health.php): IPs ou blocos CIDR, separados por virgula,
# autorizados a consultar. Vazio = somente loopback (127.0.0.1,::1).
# Inclua apenas o IP/rede do sistema de monitoracao.
HEALTH_ALLOWED_IPS=

CI_SESSION_ABSOLUTE_TIMEOUT=28800
CI_SESSION_IDLE_TIMEOUT=1800
