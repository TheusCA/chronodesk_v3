APP_ENV=production
APP_DEBUG=false
SECRET_KEY=troque_por_uma_chave_forte

# Com Apache/PHP na VM e MySQL Docker publicado em 127.0.0.1:3306, use 127.0.0.1.
# Se PHP tambem rodar em container no futuro, use o nome do servico/container na rede Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_pausas
DB_USER=chronodesk_app
DB_PASS=troque_essa_senha
DB_CHARSET=utf8mb4

ALLOWED_ORIGINS=https://chronodesk.interno.local
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict
# O exemplo de producao assume que o VirtualHost HTTPS ja foi validado.
FORCE_HTTPS=true

AUTH_SOURCE=ad
AD_DOMAIN=gruponp.local
AD_UPN_SUFFIX=paschoalotto.com.br
AD_SERVERS=servidor-ad-1.gruponp.local,servidor-ad-2.gruponp.local
AD_USE_TLS=true
ENABLE_AD_AUTO_LINK=false
# Preparacao para conta de servico futura. Nao altera o bind do login atual.
AD_CREDENTIAL_PROVIDER=none
AD_BIND_USER=
AD_BIND_PASS=
AD_BIND_USER_FILE=/run/chronodesk/ad-bind-user
AD_BIND_PASS_FILE=/run/chronodesk/ad-bind-pass
AD_ADMIN_USERS=usuario.admin
ENABLE_LOCAL_ADMIN=false

APP_BASE_URL=https://chronodesk.interno.local
METRICS_MAX_ROWS=10000
MAIL_ENABLED=false
MAIL_FROM=sdk@example.com
MAIL_FROM_NAME=ChronoDesk
MAIL_APPROVERS=aprovador1@example.com,aprovador2@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10

SENIOR_API_URL=
SAILPOINT_API_URL=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_WORKBOOK_PATH=
TEAMS_ENABLED=false
SERVICENOW_API_URL=
GRAFANA_URL=
ZABBIX_API_URL=
WAZUH_API_URL=
DOCUMENT_STORAGE_PATH=/var/lib/chronodesk/documents

CI_SESSION_ABSOLUTE_TIMEOUT=28800
CI_SESSION_IDLE_TIMEOUT=1800
