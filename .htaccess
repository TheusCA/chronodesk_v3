# ============================================
# Portal SDK - Regras de Segurança Apache
# ============================================

# Bloquear acesso direto a arquivos sensíveis (Apache 2.4)
<FilesMatch "(^\.env(\..*)?$|^(composer\..*|package.*\.json)$|\.(json|csv|xlsx|doc|docx|sql|md|log|bak|backup|zip|rar|7z|sh|bat|ps1|txt|old|orig|save)$)">
    Require all denied
</FilesMatch>

# Bloquear arquivos ocultos (.env, .gitignore, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Desabilitar listagem de diretórios
Options -Indexes

# Desabilitar server signature
ServerSignature Off

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    <FilesMatch "\.html$">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>

    # Cache do build do Vite, decidido por PREFIXO DE URL.
    #
    # app/assets/: os arquivos carregam hash no nome, entao mudou o conteudo,
    # mudou a URL. Podem ser cacheados por um ano, o que poupa workers do
    # PHP-FPM em cada navegacao.
    #
    # Todo o resto de /app/ nunca pode ser cacheado. A regra precisa ser por
    # prefixo de URL, e nao por nome de arquivo: as rotas do SPA (/app/metricas,
    # /app/admin) sao reescritas internamente para app/index.html, entao casar
    # apenas "/app/index.html" dependeria da mecanica do rewrite e deixaria as
    # rotas reescritas sem cabecalho de cache. E o index.html que aponta para o
    # hash atual dos assets: se ele ficar em cache, o usuario continua na versao
    # antiga depois do deploy.
    #
    # Os icones de public/ (favicon.png etc.) caem no ramo no-cache. Isso e
    # correto: eles nao tem hash no nome e podem mudar entre deploys.
    <If "%{REQUEST_URI} =~ m#^/app/assets/#">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/app(/|$)#">
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
    </ElseIf>
</IfModule>

# Habilitar rewrite engine
RewriteEngine On

# Base explicita do rewrite. Sem ela, o Apache resolve as substituicoes
# relativas (app/) contra o caminho fisico do diretorio e o cabecalho
# Location: passa a expor a estrutura de arquivos do servidor.
RewriteBase /

# Bloquear diretórios que nunca devem ser publicados
RewriteRule "(^|/)(\.git|\.idea|\.vscode|node_modules|vendor|classes|services|migrations|deploy|scripts|sessions|cache|tmp|uploads|chronodesk_private|private_storage)(/|$)" - [F,L]
RewriteRule "^frontend(?:/|$)" - [F,L]
RewriteRule "^api/(?:.*/)?_[^/]*\.php$" - [F,L]
RewriteRule "^(?:auth_ldap|config|config_assets|db|init|security)\.php$" - [F,L]

# Bloquear scripts operacionais que devem rodar somente via CLI
RewriteRule "^migrar_.*\.php$" - [F,L]

# Bloquear arquivos sensíveis por padrão, preservando assets estáticos em static/
RewriteRule "(^|/)(\.env(\..*)?|composer\..*|package.*\.json)$" - [F,L]
RewriteRule "\.(json|csv|xlsx|doc|docx|sql|md|log|bak|backup|zip|rar|7z|old|orig|save)$" - [F,L]

# Modo de manutencao exclusivo do ChronoDesk: com o arquivo-sinal presente
# FORA do DocumentRoot (/var/www/chronodesk.maintenance na instalacao padrao),
# toda requisicao recebe 503 sem chegar ao PHP. Os outros sites da VM seguem
# no ar. Fica DEPOIS dos bloqueios, para que caminho sensivel continue 403.
# Loopback passa, para o operador validar pela propria VM antes de reabrir.
# Procedimento: DEPLOY_LINUX.md, secao "Modo de Manutencao".
RewriteCond %{DOCUMENT_ROOT}/../chronodesk.maintenance -f
RewriteCond %{REMOTE_ADDR} !^(?:127\.0\.0\.1|::1)$
RewriteRule ^ - [R=503,L]

# Texto literal, sem arquivo: um ErrorDocument local passaria de novo pela
# regra acima. Neutro de proposito: o Apache tambem gera 503 quando o PHP-FPM
# cai, e ai "manutencao" seria mentira. Respostas 503 do proprio PHP (ex.:
# api/health.php) mantem o corpo JSON.
ErrorDocument 503 "ChronoDesk temporariamente indisponivel."

# Redirects legados: preservam links antigos que trazem o caminho de
# filesystem ou o nome do diretorio no inicio da URL.
# Ficam DEPOIS dos bloqueios para que caminho sensivel sempre responda 403,
# nunca 302. Ex.: /chronodesk/.git/config continua 403.
RewriteRule ^var/www/chronodesk(/.*)?$ /app/ [R=302,L]
RewriteRule ^chronodesk(/.*)?$ /app/ [R=302,L]

# SPA fallback limitado ao build público React.
# O portal React e a entrada oficial. Apenas paginas visuais GET/HEAD sao
# redirecionadas; POSTs legados permanecem como fallback protegido.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^$ app/ [R=302,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^(?:index|login)\.php$ app/ [R=302,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^admin_login\.php$ app/admin [R=302,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^admin\.php$ app/admin [R=302,L]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^metricas\.php$ app/metricas [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^app/(.+)/$ app/$1 [R=308,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^app(?:/.*)?$ app/index.html [L]
